# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Windows / misc installers (勿提交大体积安装包)
*.msi
*.exe

# virtual machine crash logs
hs_err_pid*
replay_pid*

# Maven
target/
.flattened-pom.xml
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# IDE / 本地工具
.idea/
*.iws
*.iml
*.ipr
.vscode/
.settings/
.classpath
.project
.arts/

# OS
.DS_Store
Thumbs.db

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 前端构建产物（克隆后执行 npm install && npm run build）
frontend/dist/

# 微信小程序 npm 构建目录（由微信开发者工具「构建 npm」生成）
frontend/miniprogram_npm/

# Environment variables - 敏感配置文件，禁止提交
.env
.env.local
.env.*.local

# Production configuration - 生产环境配置，可能包含敏感信息
application-prod.yml
application-prod.properties

# 本机 QQ 邮箱授权码等（由 application-local.example.yml 复制改名，切勿提交）
src/main/resources/application-local.yml

# 运行时/本地数据
logs/
storage/

# 一键部署脚本输出（含 Jar 与 dist）
deploy/release/

# 告警运行时配置（含邮箱等，用 alarm-config.example.json 为模板本地复制）
alarm-config.json
agent-path-policy-overrides.json
