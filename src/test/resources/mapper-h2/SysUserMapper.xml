<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.award.log.mapper.SysUserMapper">

    <sql id="PublicColumns">
        user_id, username, role, email, wechat_userid, create_time, update_time
    </sql>

    <sql id="AuthColumns">
        user_id, username, password, role, email, wechat_userid, create_time, update_time
    </sql>

    <select id="selectById" parameterType="java.lang.Integer" resultType="com.award.log.model.SysUser">
        SELECT <include refid="PublicColumns"/> FROM sys_user WHERE user_id = #{userId}
    </select>

    <select id="selectByUsername" parameterType="java.lang.String" resultType="com.award.log.model.SysUser">
        SELECT <include refid="PublicColumns"/> FROM sys_user WHERE username = #{username}
    </select>

    <select id="selectByEmail" parameterType="java.lang.String" resultType="com.award.log.model.SysUser">
        SELECT <include refid="PublicColumns"/> FROM sys_user WHERE email = #{email}
    </select>

    <select id="selectAuthByUsername" parameterType="java.lang.String" resultType="com.award.log.model.SysUser">
        SELECT user_id, username, password, role FROM sys_user WHERE username = #{username}
    </select>

    <select id="selectAuthById" parameterType="java.lang.Integer" resultType="com.award.log.model.SysUser">
        SELECT <include refid="AuthColumns"/> FROM sys_user WHERE user_id = #{userId}
    </select>

    <select id="selectPasswordHashById" resultType="java.lang.String">
        SELECT password FROM sys_user WHERE user_id = #{userId}
    </select>

    <select id="selectRoleById" resultType="java.lang.Integer">
        SELECT role FROM sys_user WHERE user_id = #{userId}
    </select>

    <select id="existsById" resultType="boolean">
        SELECT COUNT(1) > 0 FROM sys_user WHERE user_id = #{userId}
    </select>

    <select id="existsByUsername" resultType="boolean">
        SELECT COUNT(1) > 0 FROM sys_user WHERE username = #{username}
    </select>

    <select id="existsByEmail" resultType="boolean">
        SELECT COUNT(1) > 0 FROM sys_user
        WHERE email = #{email} AND email IS NOT NULL AND email != ''
    </select>

    <select id="existsByEmailExcludingUser" resultType="boolean">
        SELECT COUNT(1) > 0 FROM sys_user
        WHERE email = #{email}
          AND user_id != #{userId}
          AND email IS NOT NULL
          AND email != ''
    </select>

    <select id="selectAll" resultType="com.award.log.model.SysUser">
        SELECT <include refid="PublicColumns"/> FROM sys_user
    </select>

    <select id="selectPage" resultType="com.award.log.model.SysUser">
        SELECT <include refid="PublicColumns"/> FROM sys_user LIMIT #{offset}, #{limit}
    </select>

    <select id="countAll" resultType="java.lang.Long">
        SELECT COUNT(*) FROM sys_user
    </select>

    <insert id="insert" parameterType="com.award.log.model.SysUser" useGeneratedKeys="true" keyProperty="userId">
        INSERT INTO sys_user (username, password, role, email, create_time, update_time)
        VALUES (#{username}, #{password}, #{role}, #{email}, NOW(), NOW())
    </insert>

    <update id="updateById" parameterType="com.award.log.model.SysUser">
        UPDATE sys_user
        <set>
            username = #{username},
            password = #{password},
            role = #{role},
            <if test="email != null">
                email = #{email},
            </if>
            <if test="wechatUserid != null">
                wechat_userid = #{wechatUserid},
            </if>
            update_time = NOW()
        </set>
        WHERE user_id = #{userId}
    </update>

    <update id="updateProfileFields">
        UPDATE sys_user
        SET email = #{email},
            wechat_userid = #{wechatUserid},
            update_time = NOW()
        WHERE user_id = #{userId}
    </update>

    <update id="updatePasswordById">
        UPDATE sys_user
        SET password = #{password},
            update_time = NOW()
        WHERE user_id = #{userId}
    </update>

    <update id="updateRoleById">
        UPDATE sys_user
        SET role = #{role},
            update_time = NOW()
        WHERE user_id = #{userId}
    </update>

    <delete id="deleteById" parameterType="java.lang.Integer">
        DELETE FROM sys_user WHERE user_id = #{userId}
    </delete>

    <select id="selectAdminUsers" resultType="com.award.log.model.SysUser">
        SELECT <include refid="PublicColumns"/> FROM sys_user WHERE role = 1
    </select>
</mapper>
